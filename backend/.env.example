# ================================================
# Smart Budget App - Backend Configuration
# ================================================
# Copy this file to .env and update with your values
# IMPORTANT: Choose the configuration matching your database setup!

# ---- Server Configuration ----
PORT=5000
NODE_ENV=development

# ================================================
# DATABASE CONFIGURATION
# ================================================
# ⚠️ CHOOSE ONE OPTION BELOW:
#
# Option A: Docker Compose (port 54320)
# Option B: Local PostgreSQL (port 5432)
#
# Uncomment the section matching your setup!
# ================================================

# ---- Option A: Docker Compose Setup ----
# Use this if running: docker-compose up -d postgres
# Docker maps container port 5432 to host port 54320

DB_HOST=localhost
DB_PORT=54320
DB_NAME=smart_budget
DB_USER=smartbudget
DB_PASSWORD=dev_password_123
DATABASE_URL=postgresql://smartbudget:dev_password_123@localhost:54320/smart_budget

# ---- Option B: Local PostgreSQL Setup ----
# Use this if you have PostgreSQL installed locally
# Uncomment these lines and comment out Option A above

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smart_budget
# DB_USER=postgres
# DB_PASSWORD=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_budget

# ================================================
# Authentication Configuration
# ================================================
# JWT secret for token signing (REQUIRED)
# Generate a secure secret with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ================================================
# Email Configuration (SMTP)
# ================================================
# For Gmail:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App-Specific Password:
#    - Go to: https://myaccount.google.com/apppasswords
#    - Select "Mail" and your device
#    - Copy the generated 16-character password
# 3. Use your Gmail address and the app password below
#
# For Production: Consider using SendGrid, AWS SES, or similar service

SMTP_EMAIL=your-app@gmail.com
SMTP_PASSWORD=your-app-specific-password-here
FRONTEND_URL=http://localhost:3000

# Contact form notifications (defaults to SMTP_EMAIL if not set)
CONTACT_EMAIL=your-contact-email@gmail.com

# ================================================
# AI Configuration (OpenAI GPT & Google Gemini)
# ================================================
# At least one AI provider is required for AI features
#
# OpenAI API Key (Primary - GPT-5.1):
# 1. Sign up at: https://platform.openai.com/
# 2. Go to: https://platform.openai.com/api-keys
# 3. Create a new API key
# 4. Copy and paste below
#
# Google Gemini API Key (Fallback):
# 1. Sign up at: https://makersuite.google.com/
# 2. Get API key from: https://makersuite.google.com/app/apikey
# 3. Copy and paste below

OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GEMINI_API_KEY=AIza-your-gemini-api-key-here

# ================================================
# TROUBLESHOOTING
# ================================================
# Connection Issues?
# 1. Verify database is running:
#    - Docker: docker ps
#    - Local: pg_isready -h localhost -p 5432
# 2. Check port matches your setup (54320 vs 5432)
# 3. Restart backend after changing .env
# 4. See README.md Troubleshooting section
# ================================================
